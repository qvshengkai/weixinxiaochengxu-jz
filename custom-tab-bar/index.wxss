.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 999;
  height: calc(72rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(255, 255, 255, .6);
  border-top: 1rpx solid rgba(255, 255, 255, .7);
  box-shadow: 0 -6rpx 24rpx rgba(80, 50, 110, .12);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  font-size: 18rpx;
  color: #8577A0;
}
.tab-item.active { color: #E4789F; font-weight: 700; }
.tab-item .tic { font-size: 34rpx; line-height: 1; }
