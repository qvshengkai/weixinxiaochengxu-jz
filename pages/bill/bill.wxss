.bill { height: 100vh; box-sizing: border-box; }

.list-head { padding: 8rpx 32rpx 16rpx; }
.list-toprow { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.list-toprow .ttl2 { font-family: 'ZCOOL KuaiLe', cursive; font-weight: 400; font-size: 36rpx; color: #fff; }
.manage-btn { font-size: 24rpx; color: #fff; background: rgba(255, 255, 255, .18); padding: 10rpx 24rpx; border-radius: 24rpx; }

.import-btn {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  background: #fff; color: var(--wxgreen);
  border: 3rpx solid var(--wxgreen);
  border-radius: 28rpx; padding: 18rpx 0; font-size: 26rpx; font-weight: 700;
  margin-bottom: 20rpx;
}

.search-box { margin-bottom: 20rpx; }
.search-input {
  background: var(--glass-strong);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.filter-row { white-space: nowrap; display: flex; }
.filter-chip {
  flex-shrink: 0; height: 52rpx; line-height: 52rpx;
  padding: 0 26rpx; border-radius: 26rpx;
  font-size: 24rpx; color: #F1E4FA; background: rgba(255, 255, 255, .14); margin-right: 12rpx;
  text-align: center;
}
.filter-chip.sel { background: #fff; color: var(--ink); font-weight: 700; }
.filter-chip.search { background: rgba(255, 255, 255, .14); width: 60rpx; text-align: center; }
.search-inline { display: inline-block; }

.batch-bar {
  display: flex; justify-content: space-between; align-items: center;
  margin: 0 32rpx 12rpx; padding: 14rpx 24rpx;
  background: rgba(255, 255, 255, .75); border-radius: 24rpx;
  font-size: 24rpx; color: var(--ink);
}
.batch-del { background: var(--berry); color: #fff; padding: 10rpx 24rpx; border-radius: 20rpx; font-weight: 700; }

.list-body {
  padding: 16rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  height: calc(100vh - 360rpx - 72rpx - env(safe-area-inset-bottom));
}

.day-group { margin-bottom: 12rpx; }
.day-head { display: flex; justify-content: space-between; align-items: baseline; font-size: 22rpx; color: #5A4A80; margin-bottom: 12rpx; font-weight: 600; }
.day-head .wk { color: var(--berry); font-weight: 400; margin-left: 12rpx; }

.ledger-card { padding: 2rpx 24rpx; margin-bottom: 24rpx; border-radius: 32rpx; }
.ledger-row { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx dashed rgba(150, 120, 190, .25); }
.ledger-row:last-child { border-bottom: none; }
.ledger-row.selectable { opacity: .9; }
.chk {
  width: 32rpx; height: 32rpx; border-radius: 10rpx; flex-shrink: 0;
  border: 3rpx solid #B79CEA; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 22rpx; background: #B79CEA;
}
.icon-badge {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
  background: #FFFDF7; border: 4rpx solid #D9CFEA; box-shadow: 0 4rpx 16rpx rgba(120, 90, 160, .15); flex-shrink: 0;
}
.ledger-mid { flex: 1; min-width: 0; }
.ledger-mid .t1 { font-size: 28rpx; font-weight: 500; color: var(--ink); }
.ledger-mid .t2 { font-size: 21rpx; color: #9A8CBB; margin-top: 2rpx; }
.ledger-mid .t2 .src { color: var(--sky-acc); }
.ledger-right { display: flex; align-items: center; gap: 16rpx; }
.ledger-amt { font-size: 28rpx; font-weight: 700; }
.ledger-amt.neg { color: var(--berry); }
.ledger-amt.pos { color: #2F8F72; }
.row-actions { display: flex; gap: 8rpx; }
.ra-btn {
  width: 44rpx; height: 44rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; background: rgba(150, 120, 190, .14); color: #6B5A90;
}

.empty-state { text-align: center; padding: 80rpx 40rpx; color: #8577A0; }
.empty-state .ic { font-size: 68rpx; margin-bottom: 20rpx; }
.empty-state .t { font-size: 25rpx; }

/* ===== 编辑记录弹窗 ===== */
.edit-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(40, 28, 60, .45);
  z-index: 100;
  display: flex; align-items: flex-end;
}
.edit-panel {
  width: 100%;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -10rpx 40rpx rgba(80, 50, 110, .25);
}
.ep-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.ep-title { font-size: 30rpx; font-weight: 700; color: var(--ink); font-family: 'ZCOOL KuaiLe', cursive; }
.ep-close { font-size: 32rpx; color: var(--ink-soft); padding: 0 12rpx; }

.ep-type { display: flex; margin-bottom: 20rpx; background: #F1ECF6; border-radius: 20rpx; padding: 6rpx; }
.ep-type .opt { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: var(--ink-soft); border-radius: 16rpx; }
.ep-type .opt.sel { background: linear-gradient(135deg, #B79CEA, #F3A6C4); color: #fff; font-weight: 700; }

.ep-amount { display: flex; align-items: baseline; padding: 8rpx 8rpx 20rpx; border-bottom: 1rpx solid #EEE6F2; margin-bottom: 16rpx; }
.ep-amount .cny { font-size: 40rpx; color: var(--ink); font-weight: 700; margin-right: 8rpx; }
.ep-amt-input { flex: 1; font-size: 56rpx; font-weight: 700; color: var(--ink); }
.ep-ph { color: #C9BEDD; }

.ep-cat-scroll { max-height: 420rpx; margin-bottom: 16rpx; }
.cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.cat-tile { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.cat-tile .box {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  border: 2rpx solid #D9CFEA; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; background: #fff;
}
.cat-tile.sel .box { background: linear-gradient(135deg, #E4789F, #B79CEA); border-color: transparent; color: #fff; box-shadow: 0 8rpx 24rpx rgba(200, 120, 170, .5); }
.cat-tile .lb { font-size: 20rpx; color: var(--ink-soft); }
.cat-tile.sel .lb { color: var(--ink); font-weight: 700; }

.ep-note { background: #F1ECF6; border-radius: 20rpx; padding: 20rpx 24rpx; font-size: 26rpx; color: var(--ink); margin-bottom: 24rpx; }

.ep-actions { display: flex; gap: 20rpx; }
.ep-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 24rpx; font-size: 28rpx; font-weight: 700; }
.ep-btn.cancel { background: #F1ECF6; color: var(--ink-soft); }
.ep-btn.save { background: linear-gradient(135deg, #B79CEA, #F3A6C4); color: #fff; }
