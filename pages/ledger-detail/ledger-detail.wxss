/* pages/ledger-detail/ledger-detail.wxss */
/* 全局 box-sizing 保护，防止 padding/border 撑破宽度 */
view, button, scroll-view, text {
  box-sizing: border-box;
}
.page { min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }

.wx-nav {
  position: relative; z-index: 10;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 28rpx 16rpx;
  color: #4a3b5c; font-weight: 700;
}
.nav-back { font-size: 28rpx; color: #8F466D; }
.nav-title { font-size: 34rpx; }
.nav-share { font-size: 28rpx; color: #8F466D; }

.ld-body {
  flex: 1;
  width: 100%;
  min-width: 0;
  padding: 0 28rpx 40rpx;
  overflow-x: hidden;
  box-sizing: border-box;
}
.ld-hero { margin: 16rpx 0 28rpx; padding: 32rpx; border-radius: 28rpx; }
.ld-name { font-size: 36rpx; color: #4a3b5c; font-weight: 700; }
.ld-meta { margin-top: 10rpx; font-size: 22rpx; color: #9b8aa8; }
.ld-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.ld-btn {
  flex: 1; height: 76rpx; line-height: 76rpx; margin: 0; padding: 0;
  border-radius: 38rpx; font-size: 26rpx;
}
.ld-btn.primary { color: #fff; background: linear-gradient(135deg, #8fb7ea, #b79cea); }
.ld-btn.ghost { color: #8F466D; background: #f6eff9; border: 2rpx solid #e8d9f0; }

.ld-section-title { margin: 28rpx 0 14rpx 8rpx; font-size: 24rpx; color: #9b8aa8; }
.ld-list { padding: 8rpx 24rpx; border-radius: 28rpx; }
.ld-member { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid rgba(183,156,234,.15); }
.ld-member:last-child { border-bottom: none; }
.ld-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #F4EDF8; display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.ld-mname { flex: 1; font-size: 26rpx; color: #4a3b5c; }
.ld-owner-badge { font-size: 26rpx; }

.ld-record { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid rgba(183,156,234,.15); }
.ld-record:last-child { border-bottom: none; }
.ld-reco-icon { font-size: 30rpx; }
.ld-reco-info { flex: 1; }
.ld-reco-name { font-size: 26rpx; color: #4a3b5c; font-weight: 600; }
.ld-reco-note { font-size: 20rpx; color: #9b8aa8; margin-top: 2rpx; }
.ld-reco-amount { font-size: 28rpx; font-weight: 700; }
.ld-reco-amount.expense { color: #e06a6a; }
.ld-reco-amount.income { color: #4caf7d; }

.ld-empty { padding: 40rpx; text-align: center; border-radius: 28rpx; }
.ld-empty-txt { font-size: 24rpx; color: #9b8aa8; }

.ld-leave {
  margin: 40rpx 0 16rpx;
  height: 84rpx; line-height: 84rpx; text-align: center;
  border-radius: 42rpx; color: #e06a6a;
  background: #fdf0f0; font-size: 26rpx; font-weight: 600;
}

.ld-loading { text-align: center; padding: 60rpx; color: #9b8aa8; font-size: 24rpx; }

/* 邀请按钮（open-type=share）去掉 button 默认样式 */
button.nav-share,
button.ld-btn {
  margin: 0;
  padding: 0;
  border: none;
  background: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
button.nav-share::after,
button.ld-btn::after { border: none; }
.nav-share { font-size: 28rpx; color: #8F466D; font-weight: 700; height: auto; line-height: 1; }

/* 账本统计 */
.ld-stats { padding: 28rpx 24rpx; border-radius: 28rpx; overflow: hidden; }
.ld-stats-row { display: flex; }
.ld-stat { flex: 1; min-width: 0; text-align: center; }
.ld-stat-v { font-size: 32rpx; font-weight: 700; color: #4a3b5c; }
.ld-stat-v.expense { color: #e06a6a; }
.ld-stat-v.income { color: #4caf7d; }
.ld-stat-l { margin-top: 6rpx; font-size: 20rpx; color: #9b8aa8; }

.ld-stats-sub { margin: 24rpx 0 10rpx; font-size: 22rpx; color: #9b8aa8; }
.ld-member-stat {
  display: flex; align-items: center; gap: 14rpx;
  padding: 14rpx 0; border-bottom: 1rpx solid rgba(183,156,234,.15);
}
.ld-member-stat:last-child { border-bottom: none; }
.ld-mstat-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: #F4EDF8; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.ld-mstat-info { flex: 1; }
.ld-mstat-name { font-size: 24rpx; color: #4a3b5c; font-weight: 600; }
.ld-mstat-count { font-size: 20rpx; color: #9b8aa8; }
.ld-mstat-amount { font-size: 26rpx; font-weight: 700; color: #e06a6a; }
.ld-stats-empty { padding: 20rpx 0; text-align: center; font-size: 22rpx; color: #9b8aa8; }

/* 防溢出：长文本截断 */
.ld-name, .ld-meta, .ld-mname, .ld-reco-name, .ld-reco-note {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ld-mstat-amount, .ld-reco-amount {
  flex-shrink: 0;
  max-width: 50%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ld-mstat-info, .ld-reco-info { min-width: 0; }
