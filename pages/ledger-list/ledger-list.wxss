/* pages/ledger-list/ledger-list.wxss */
view, button, scroll-view, input, text {
  box-sizing: border-box;
}
.page { min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }

.wx-nav {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx 16rpx;
  color: #4a3b5c;
  font-weight: 700;
}
.nav-back { font-size: 28rpx; color: #8F466D; width: 100rpx; flex-shrink: 0; }
.nav-title {
  font-size: 34rpx;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.nav-placeholder { width: 100rpx; flex-shrink: 0; }

.ledger-body {
  flex: 1;
  width: 100%;
  min-width: 0;
  padding: 0 28rpx 40rpx;
  overflow-x: hidden;
  box-sizing: border-box;
}
.ledger-summary {
  margin: 16rpx 0 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
}
.ledger-sum-title { font-size: 32rpx; color: #4a3b5c; font-weight: 700; }
.ledger-sum-tip { margin-top: 12rpx; font-size: 22rpx; color: #9b8aa8; line-height: 1.5; }

.ledger-section-title { margin: 28rpx 0 14rpx 8rpx; font-size: 24rpx; color: #9b8aa8; }
.ledger-list { padding: 8rpx 24rpx; border-radius: 28rpx; }
.ledger-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(183, 156, 234, .15);
}
.ledger-item:last-child { border-bottom: none; }
.ledger-icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #F4EDF8; font-size: 36rpx; }
.ledger-info { flex: 1; }
.ledger-name { font-size: 28rpx; color: #4a3b5c; font-weight: 600; }
.ledger-meta { margin-top: 4rpx; font-size: 22rpx; color: #9b8aa8; }
.ledger-chev { font-size: 30rpx; color: #c4b6d0; }

.ledger-empty { padding: 60rpx 28rpx; text-align: center; border-radius: 28rpx; }
.le-empty-icon { font-size: 64rpx; }
.le-empty-txt { margin-top: 16rpx; font-size: 28rpx; color: #4a3b5c; font-weight: 600; }
.le-empty-sub { margin-top: 8rpx; font-size: 22rpx; color: #9b8aa8; }

.ledger-loading { text-align: center; padding: 40rpx; color: #9b8aa8; font-size: 24rpx; }

.ledger-add-btn {
  margin: 32rpx 0 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  color: #fff;
  background: linear-gradient(135deg, #8fb7ea, #b79cea);
  font-size: 28rpx;
  font-weight: 600;
}
.ledger-tip { text-align: center; font-size: 20rpx; color: #b3a6bf; }

.add-mask {
  position: fixed; inset: 0; z-index: 30;
  background: rgba(40, 25, 60, .45);
  opacity: 0; pointer-events: none;
  transition: opacity .2s;
}
.add-mask.show { opacity: 1; pointer-events: auto; }

.add-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 31;
  background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%); transition: transform .25s;
  box-shadow: 0 -12rpx 40rpx rgba(100, 69, 123, .15);
}
.add-sheet.show { transform: translateY(0); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; font-size: 28rpx; color: #8F466D; }
.sheet-title { font-size: 30rpx; color: #4a3b5c; font-weight: 700; }
.sheet-body { margin-top: 28rpx; }
.create-input {
  height: 88rpx; padding: 0 28rpx;
  border: 2rpx solid #eee4f2; border-radius: 20rpx;
  font-size: 28rpx; color: #4a3b5c; background: #faf7fc;
}
.create-btn {
  margin-top: 24rpx; height: 88rpx; line-height: 88rpx;
  border-radius: 44rpx; color: #fff; font-size: 28rpx;
  background: linear-gradient(135deg, #8fb7ea, #b79cea);
}
.create-btn[disabled] { opacity: .6; }

/* 防溢出 */
.ledger-sum-title, .ledger-sum-tip, .ledger-name, .ledger-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ledger-info { min-width: 0; }
.ledger-chev { flex-shrink: 0; }
