/* 首页整体：按 doc/prototype/record-entry-bottom-sheet.html 1:1 复核 */
/* 375px 原型 -> 750rpx，px*2=rpx；TabBar 高 72rpx + safe-area 已预留 */
.record-page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(165deg, #725b9d 0, #a383b9 40%, #f9f6fb 40%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  color: #4a3b66;
}

/* 顶部导航（custom navigationStyle） */
.wx-nav {
  position: relative;
  z-index: 10;
  padding: 40rpx 40rpx 0;
  color: #fff;
}
.nav-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin: 48rpx 0 10rpx;
}

/* 可滚动内容区 */
.home-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 36rpx 200rpx;
  box-sizing: border-box;
}

/* 今日支出卡片 */
.home-hero {
  margin: 28rpx 0 0;
  padding: 40rpx;
  border: 2rpx solid rgba(255,255,255,.38);
  border-radius: 48rpx;
  background: rgba(255,255,255,.15);
  color: #fff;
  display: flex;
  flex-direction: column;
}
.home-date {
  font-size: 26rpx;
  color: #f0e5f8;
}
.home-label {
  margin-top: 0;
  font-size: 24rpx;
  color: #f1e6f8;
}
.home-amount {
  margin: 14rpx 0;
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1.1;
}
.home-hint {
  font-size: 24rpx;
  color: #f0e5f8;
}

/* 空状态 */
.home-empty {
  margin: 340rpx 40rpx 0;
  padding: 36rpx 32rpx;
  text-align: center;
  color: #4a3b66;
  font-size: 26rpx;
  line-height: 1.7;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, .85);
  box-shadow: 0 10rpx 30rpx rgba(79, 56, 110, .14);
}
.empty-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: #8a6fc0;
  background: rgba(183, 156, 234, .18);
}

/* 底部 dock */
.entry-dock {
  position: fixed;
  z-index: 20;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.composer-dock {
  padding: 18rpx;
  border: 2rpx solid rgba(255,255,255,.78);
  border-radius: 34rpx;
  background: rgba(255,255,255,.94);
  box-shadow: 0 18rpx 48rpx rgba(100,69,123,.19);
}
.composer-modes {
  display: flex;
  gap: 12rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}
.composer-mode {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  border-radius: 28rpx;
  color: #806b94;
  background: #f6eff9;
  font-size: 22rpx;
  white-space: nowrap;
}
.composer-mode.active {
  color: #fff;
  background: linear-gradient(135deg, #b79cea, #f3a6c4);
  box-shadow: 0 8rpx 18rpx rgba(177,125,183,.25);
}
.composer-hint { padding: 0 6rpx 12rpx; color: #816e97; font-size: 23rpx; }
.composer-examples { display: flex; gap: 10rpx; overflow: hidden; padding-bottom: 14rpx; }
.composer-example { flex: 0 0 auto; padding: 8rpx 16rpx; border-radius: 20rpx; color: #89699c; background: #f3e8f6; font-size: 21rpx; }
.composer-row { display: flex; align-items: center; gap: 12rpx; }
.composer-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid #eee4f2;
  border-radius: 38rpx;
  color: #4a3b66;
  background: #fff;
  font-size: 25rpx;
}
.composer-send {
  flex: 0 0 104rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 38rpx;
  color: #fff;
  background: linear-gradient(135deg, #8fb7ea, #b79cea);
  font-size: 24rpx;
  line-height: 76rpx;
}
.composer-mic {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8fb7ea, #b79cea);
  box-shadow: 0 10rpx 24rpx rgba(121,80,169,.25);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}
.mic-cap { width: 18rpx; height: 24rpx; border-radius: 9rpx; background: #fff; }
.mic-arc { width: 28rpx; height: 13rpx; border: 2.5rpx solid #fff; border-top: 0; border-radius: 0 0 14rpx 14rpx; background: transparent; }

/* 遮罩 & sheet */
.entry-mask, .picker-backdrop {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(36,27,50,.66);
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s;
}
.entry-mask.show { opacity: 1; pointer-events: auto; }

.entry-sheet {
  position: fixed;
  z-index: 50;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  height: 1210rpx;
  padding: 0 34rpx 34rpx;
  box-sizing: border-box;
  overflow-y: auto;
  border-radius: 58rpx 58rpx 0 0;
  background: #fbf8fd;
  transform: translateY(105%);
  transition: transform .27s;
}
.entry-sheet.show { transform: translateY(0); }

.sheet-head {
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #89799d;
  font-size: 28rpx;
}
.sheet-title {
  color: #4a3b66;
  font-size: 32rpx;
  font-weight: 700;
}
.sheet-close {
  font-size: 46rpx;
  line-height: 1;
  padding: 0 10rpx;
}

/* 收支类型切换 */
.type-switch {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  background: transparent;
  border: 0;
  border-radius: 0;
  padding: 0;
}
.sheet-type { width: auto; margin: 0 auto; }

/* 记账面板：账本切换 */
.ledger-switch {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx 4rpx;
}
.ledger-label { font-size: 24rpx; color: #9b8aa8; flex-shrink: 0; }
.ledger-options {
  display: flex;
  gap: 10rpx;
  flex-wrap: nowrap;
  overflow-x: auto;
  flex: 1;
  padding-bottom: 4rpx;
}
.lopt {
  flex: 0 0 auto;
  padding: 10rpx 24rpx;
  border-radius: 26rpx;
  font-size: 22rpx;
  color: #806b94;
  background: #f6eff9;
  white-space: nowrap;
}
.lopt.sel {
  color: #fff;
  background: linear-gradient(135deg, #8fb7ea, #b79cea);
}
.lopt.add { background: #f3e8f6; color: #89699c; font-weight: 700; }
.type-switch .opt {
  flex: 0 0 auto;
  text-align: center;
  padding: 14rpx 48rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #876fa2;
  background: transparent;
}
.type-switch .opt.sel {
  background: #eadcf2;
  color: #8a4e78;
  font-weight: 700;
}

/* 金额 */
.sheet-amount {
  margin: 28rpx 0 36rpx;
  padding: 0;
  text-align: center;
  color: #4a3b66;
}
.amount-label { display: none; }
.amount-yuan { font-size: 44rpx; margin-right: 8rpx; font-weight: 750; }
.amount-number { font-size: 86rpx; font-weight: 750; }

/* 语音结果面板 */
.voice-panel {
  background: rgba(180,150,220,.12);
  border: 1rpx dashed rgba(180,150,220,.5);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}
.voice-quote { color: #8577a0; font-size: 23rpx; margin-bottom: 10rpx; }
.voice-chips { display: flex; flex-wrap: wrap; gap: 10rpx; }
.vchip { background: #fff; border: 1rpx solid rgba(180,150,220,.4); border-radius: 20rpx; padding: 6rpx 14rpx; color: #4a3b66; font-size: 21rpx; }

/* 字段列表 */
.detail-list {
  padding: 6rpx 28rpx;
  border: 2rpx solid #eee6f3;
  border-radius: 32rpx;
  background: #fff;
}
.detail-row {
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #f1ebf5;
  color: #4a3b66;
  font-size: 26rpx;
}
.detail-row:last-child { border: 0; }
.detail-value { display: flex; align-items: center; gap: 14rpx; color: #806b94; }
.note-input { flex: 1; margin-left: 28rpx; min-width: 0; text-align: right; font-size: 26rpx; color: #806b94; }

.ai-entry {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 12rpx;
  border: 2rpx solid #eee6f3;
  border-radius: 24rpx;
  background: rgba(255,255,255,.82);
}
.ai-input { flex: 1; min-width: 0; color: #4a3b66; font-size: 24rpx; }
.ai-fill-btn {
  width: 144rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  color: #fff;
  background: linear-gradient(135deg, #8fb7ea, #b79cea);
  font-size: 23rpx;
  line-height: 58rpx;
}
.ai-fill-btn[disabled] { opacity: .48; }

/* 键盘 & 操作按钮 */
.sheet-keyboard { margin-top: 32rpx; }
.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.sheet-voice-btn {
  width: 108rpx;
  height: 78rpx;
  border: 0;
  border-radius: 28rpx;
  background: #efe5f2;
  color: #95638e;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-save {
  flex: 1;
  height: 78rpx;
  margin: 0;
  border: 0;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #b79cea, #f3a6c4);
  font-size: 30rpx;
  font-weight: 700;
}

/* 分类选择器 */
.picker-backdrop {
  z-index: 55;
  background: rgba(36,27,50,.19);
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s;
}
.picker-backdrop.show { opacity: 1; pointer-events: auto; }

.category-picker {
  position: fixed;
  z-index: 60;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  min-height: 820rpx;
  padding: 0 36rpx 50rpx;
  border-radius: 58rpx 58rpx 0 0;
  background: #fff;
  transform: translateY(105%);
  transition: transform .27s;
}
.category-picker.show { transform: translateY(0); }

.picker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 36rpx 16rpx;
}
.picker-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: #746582;
  font-size: 22rpx;
}
.picker-icon {
  width: 94rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f4edf8;
  font-size: 46rpx;
}
.picker-item.selected { color: #8a4e78; font-weight: 700; }
.picker-item.selected .picker-icon { background: #f6e1eb; box-shadow: 0 0 0 6rpx #f9d6e4; }
.picker-add .picker-icon { background: transparent; border: 2rpx dashed #c7bedd; color: #b79cea; }

/* 录音提示 */
.voice-overlay {
  position: fixed;
  z-index: 80;
  left: 0;
  right: 0;
  bottom: 320rpx;
  padding: 30rpx 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  background: transparent;
  pointer-events: none;
}
.voice-overlay .vo-mic { pointer-events: auto; }
.voice-overlay .vo-cancel { pointer-events: auto; }
.vo-mic {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg,#E4789F,#B79CEA);
  font-size: 56rpx;
  box-shadow: 0 0 40rpx rgba(228,120,159,.6);
}
.vo-wave { display: flex; align-items: center; gap: 10rpx; height: 80rpx; }
.vo-bar { width: 10rpx; height: 48rpx; border-radius: 6rpx; background: linear-gradient(180deg,#8FB7EA,#E4789F); }
.vo-txt { color: #F1E4FA; font-size: 26rpx; font-weight: 600; }
.vo-cancel { margin-top: 4rpx; padding: 10rpx 28rpx; border-radius: 28rpx; color: #fff; background: rgba(255,255,255,.22); font-size: 24rpx; }

/* 账本切换条 */
.ledger-switch-bar {
  position: relative;
  z-index: 5;
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx 20rpx;
}
.ledger-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .65);
  border: 1rpx solid rgba(255, 255, 255, .8);
  color: #5e4e75;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(80, 50, 110, .08);
}
.ledger-tag.sel {
  background: linear-gradient(135deg, #8fb7ea, #b79cea);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(143, 183, 234, .45);
}
.lt-icon { font-size: 24rpx; }
.lt-text {
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
