.me { height: 100vh; box-sizing: border-box; }

.me-head { padding: 8rpx 32rpx 24rpx; }
.me-card { display: flex; align-items: center; gap: 28rpx; padding: 28rpx; border-radius: 40rpx; }
.avatar {
  width: 108rpx; height: 108rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFF7DE 0%, #FFE9AE 55%, #F3CE7C 100%);
  display: flex; align-items: center; justify-content: center; font-size: 48rpx; flex-shrink: 0;
  box-shadow: 0 0 32rpx rgba(255, 217, 119, .5);
}
.me-info { flex: 1; min-width: 0; }
.me-info .nick { font-family: 'ZCOOL KuaiLe', cursive; font-weight: 400; font-size: 32rpx; color: var(--ink); margin-bottom: 8rpx; }
.me-info .streak { font-size: 23rpx; color: #8577A0; display: flex; align-items: center; }
.me-info .streak b { color: var(--berry); margin: 0 4rpx; }
.me-arrow { color: #B79CEA; font-size: 36rpx; }

.me-stats { display: flex; margin-top: 20rpx; padding: 24rpx 0; border-radius: 32rpx; }
.me-stat { flex: 1; text-align: center; border-right: 1rpx dashed rgba(150, 120, 190, .3); }
.me-stat:last-child { border-right: none; }
.me-stat .v { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.me-stat .l { font-size: 21rpx; color: #9A8CBB; margin-top: 4rpx; }

.me-body {
  padding: 0 32rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  height: calc(100vh - 360rpx - 72rpx - env(safe-area-inset-bottom));
}
.me-group-title { font-size: 22rpx; color: #F1E4FA; letter-spacing: .1em; margin: 28rpx 8rpx 16rpx; }
.me-list { border-radius: 32rpx; overflow: hidden; }
.me-item { display: flex; align-items: center; gap: 24rpx; padding: 26rpx 28rpx; border-bottom: 1rpx solid rgba(150, 120, 190, .15); }
.me-item:last-child { border-bottom: none; }
.me-item .mic { width: 60rpx; height: 60rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; background: linear-gradient(135deg, #F3E3FF, #FFE3EE); flex-shrink: 0; }
.me-item .mtxt { flex: 1; font-size: 28rpx; color: var(--ink); }
.me-item .msub { font-size: 22rpx; color: #9A8CBB; margin-top: 4rpx; }
.me-item .mchev { color: #C6B8E6; font-size: 30rpx; }
.me-item .mval { font-size: 24rpx; color: #9A8CBB; }

.toggle { width: 76rpx; height: 44rpx; border-radius: 22rpx; background: rgba(150, 120, 190, .25); position: relative; flex-shrink: 0; }
.toggle.on { background: linear-gradient(135deg, #B79CEA, #F3A6C4); }
.toggle::after { content: ''; position: absolute; top: 4rpx; left: 4rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #fff; transition: .2s; }
.toggle.on::after { left: 36rpx; }

.me-item.locked { opacity: .65; }
.lock-badge { font-size: 19rpx; background: rgba(150, 120, 190, .2); color: #6B5A90; padding: 6rpx 16rpx; border-radius: 16rpx; font-weight: 700; flex-shrink: 0; }
