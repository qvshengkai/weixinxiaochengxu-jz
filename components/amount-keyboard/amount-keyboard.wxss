.kbd {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.key {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(96,69,123,.09);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 36rpx;
  font-weight: 500;
  color: #4a3b66;
}
.key:active { background: #ece6f5; }
.key.fn {
  font-size: 26rpx;
  color: #9a8cbb;
}
