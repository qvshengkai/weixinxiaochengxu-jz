.star-bg {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 0;
  background: linear-gradient(180deg, #6E5AA8 0%, #9B84CB 40%, #F5CBDD 100%);
}
.starfield {
  position: absolute;
  inset: 0;
  opacity: .7;
  background-image:
    radial-gradient(1.5px 1.5px at 20px 30px, #fff 100%, transparent 100%),
    radial-gradient(1.5px 1.5px at 90px 80px, #fff 100%, transparent 100%),
    radial-gradient(1px 1px at 150px 20px, #fff 100%, transparent 100%),
    radial-gradient(2px 2px at 250px 60px, #fff 100%, transparent 100%),
    radial-gradient(1px 1px at 300px 110px, #fff 100%, transparent 100%),
    radial-gradient(1.5px 1.5px at 60px 200px, #fff 100%, transparent 100%),
    radial-gradient(1px 1px at 200px 160px, #fff 100%, transparent 100%),
    radial-gradient(2px 2px at 320px 220px, #fff 100%, transparent 100%);
}
.glow {
  position: absolute;
  left: -20%; top: -10%;
  width: 140%; height: 50%;
  background: radial-gradient(ellipse at 50% 0%, rgba(255, 217, 119, .25), transparent 70%);
}
